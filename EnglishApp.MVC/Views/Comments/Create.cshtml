@model EnglishApp.BusinessLogic.DTOs.CourseCommentDTO


<h2 class="my-1">
    Leave Your Review
</h2>
<form asp-action="Create" asp-antiforgery="true" class="form">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="form-body">
        <label>
            Ratings
        </label>
        <div class="mb-1" id="customer-review">
        </div>
        <div class="row">
            <div class="col-md-12">
                <input type="hidden" asp-for="CourseId" />
                <input type="hidden" asp-for="CustomerId" />
                <div class="form-group">
                    <label for="subject">
                        Subject
                    </label>
                    <input class="form-control" asp-for="Subject" id="subject" name="subject" placeholder="Subject" type="text">
                    <span asp-validation-for="Subject" class="text-danger"></span>

                </div>
            </div>
        </div>
        <div class="form-group">
            <label for="review-desc">
                Your Review
            </label>
            <textarea class="form-control" asp-for="CommentText" id ="review-desc" placeholder="Your Review" rows="5"></textarea>
            <span asp-validation-for="CommentText" class="text-danger"></span>

        </div>
        <button class="btn btn-info" type="button" onclick="SubmitComment();">
            <i class="la la-check-square-o">
            </i>
            Submit Review
        </button>
    </div>
</form>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}