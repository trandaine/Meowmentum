@model IEnumerable<EnglishApp.ApplicationCore.Entities.Lesson>

@{
    ViewData["Title"] = "Index";
}


<div>
    <a asp-action="Create" class="btn btn-info round btn-min-width mr-1 mb-1">New lesson</a>
</div>
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h4 class="card-title">All Lessons</h4>
                <a class="heading-elements-toggle"><i class="la la-ellipsis-v font-medium-3"></i></a>
                <div class="heading-elements">
                    <ul class="list-inline mb-0">
                        <li><a data-action="collapse"><i class="ft-minus"></i></a></li>
                        <li><a data-action="reload"><i class="ft-rotate-cw"></i></a></li>
                        <li><a data-action="expand"><i class="ft-maximize"></i></a></li>
                        <li><a data-action="close"><i class="ft-x"></i></a></li>
                    </ul>
                </div>
            </div>
            <div class="card-content collapse show">
                <div class="table-responsive">
                    <table class="table table-xs">
                        <thead>
                            <tr>
                                <th>
                                    No.
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Name)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Content)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.ContentType)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Video)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Audio)
                                </th>
                                <th>
                                    @Html.DisplayNameFor(model => model.Course)
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var position = 1;
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @(position++)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Name)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Content)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.ContentType)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Video)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Audio)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Course.Name)
                                        </td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-success">Edit</a>
                                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info waves-effect waves-light">Details</a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
