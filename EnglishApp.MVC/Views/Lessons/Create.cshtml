@* @model EnglishApp.ApplicationCore.Entities.Lesson *@
@model EnglishApp.BusinessLogic.DTOs.LessonDTO
@using Microsoft.AspNetCore.Mvc.TagHelpers


@{
    // ViewData["Title"] = "Create";
}

<div class="row justify-content-md-left">
    <div class="col-md-12">
        <div class="card">
            <div class="card-content collpase show">
                <div class="card-body">

                    @* <div class="card-text">
                        <p>Add <code>.form-bordered</code> to form tag to add border to a form-group. In this example centered card is used to show the bordered form functionality.</p>
                    </div> *@

                    <form id="formCreateLesson" asp-action="Create" asp-antiforgery="true" class="form form-horizontal form-bordered">
                        <input asp-for="CourseId" type="hidden" />
                        <input asp-for="Id" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <div class="form-body">
                            <div class="form-group row mx-auto">
                                <label asp-for="Name" class="col-md-3 label-control" for="eventRegInput1"></label>
                                <div class="col-md-9">
                                    <input asp-for="Name" type="text" id="eventRegInput1" class="form-control" placeholder="Lesson Name">
                                    <span asp-validation-for="Name" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group row mx-auto">
                                <label asp-for="ContentType" class="col-md-3 label-control" for="eventRegInput3">Content type</label>
                                <div class="col-md-9">
                                    <select asp-for="ContentType" id="eventRegInput3" class="form-control" asp-items="ViewBag.LessonContentType">
                                        <option value="none" selected="" disabled="">-- Select Content Type --</option>
                                    </select>
                                    <span asp-validation-for="ContentType" class="text-danger"></span>
                                </div>

                            </div>
                            <div class="form-group row mx-auto">
                                <label asp-for="Content" class="col-md-3 label-control" for="eventRegInput2">Lesson Content</label>
                                <div class="col-md-9">
                                    <input asp-for="Content" type="text" id="eventRegInput2" class="form-control" placeholder="Input your lesson content">
                                    <span asp-validation-for="Content" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group row mx-auto">
                                <label asp-for="Video" class="col-md-3 label-control" for="eventRegInput4">Lesson Video</label>
                                <div class="col-md-9">
                                    <input asp-for="Video" type="text" id="eventRegInput4" class="form-control" placeholder="Video file (Not required)">
                                    <span asp-validation-for="Video" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="form-group row mx-auto">
                                <label asp-for="Audio" type="text" class="col-md-3 label-control" for="eventRegInput5">Lesson Audio</label>
                                <div class="col-md-9">
                                    <input asp-for="Audio" id="eventRegInput5" class="form-control" placeholder="Video file (Not required)">
                                    <span asp-validation-for="Audio" class="text-danger"></span>
                                </div>
                            </div>

                            @* <div class="form-group row mx-auto">
                                <label asp-for="CourseId" type="hidden" class="col-md-3 label-control" for="eventRegInput5">Course</label>
                                <div class="col-md-9">
                                    <input asp-for="CourseId" type="hidden" id="eventRegInput6" class="form-control" placeholder="">
                                    <span asp-validation-for="CourseId" class="text-danger"></span>
                                </div>
                            </div> *@

                            @* <div class="form-group row mx-auto">
                                <label asp-for="CourseId" class="col-md-3 label-control" for="eventRegInput6">Course</label>
                                <div class="col-md-9">
                                    <select asp-for="CourseId" id="eventRegInput6" class="form-control" asp-items="ViewBag.CourseList">
                                        <option value="none" selected="" disabled="">-- Belong to course --</option>
                                    </select>
                                    <span asp-validation-for="CourseId" class="text-danger"></span>
                                </div>
                            </div> *@
                        </div>
                        <div class="form-actions text-center">
                            <button type="button" onclick="createLesson()" class="btn btn-primary">
                                <i class="la la-check-square-o"></i> Create
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
